{
  "name": "upify",
  "version": "1.1.0",
  "description": "Upify multi-host uploader",
  "main": "electron-main.js",
  "bin": "src/server.js",
  "author": {
    "name": "Matheotaku4",
    "email": "matheotaku4@users.noreply.github.com"
  },
  "homepage": "https://github.com/Matheotaku4/Upify",
  "desktopName": "upify.desktop",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "dev:desktop": "electron .",
    "build:win": "electron-builder --win portable nsis",
    "build:linux": "electron-builder --linux",
    "build:release": "electron-builder --win portable nsis",
    "build:cli-exe": "pkg . --targets node18-win-x64 --output dist/upify.exe"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "express": "^4.22.3",
    "form-data": "^4.0.6",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "pkg": "^5.8.1"
  },
  "build": {
    "appId": "com.upify.desktop",
    "productName": "Upify",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron-main.js",
      "src/**/*",
      "public/**/*",
      "API.md",
      "logo.png",
      "package.json"
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "icon.png",
      "category": "Utility",
      "syncDesktopName": true,
      "synopsis": "Upload one file to multiple file hosts in parallel",
      "description": "Upify is a local desktop and web uploader that sends a single file to many file hosting services in parallel.",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "maintainer": "Matheotaku4 <matheotaku4@users.noreply.github.com>",
      "category": "utility"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "nsis": {
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "artifactName": "${productName}-${version}-setup.${ext}"
    }
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "scripts": [
      "src/**/*.js",
      "node_modules/axios/**/*.js",
      "node_modules/axios/**/*.cjs"
    ]
  }
}
